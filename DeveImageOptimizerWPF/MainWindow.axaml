<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:DeveImageOptimizerWPF.Converters"
        xmlns:h="clr-namespace:DeveImageOptimizerWPF.Helpers"
        xmlns:local="clr-namespace:DeveImageOptimizerWPF"
        xmlns:loptstate="clr-namespace:DeveImageOptimizer.State;assembly=DeveImageOptimizer"
        mc:Ignorable="d"
        x:Class="DeveImageOptimizerWPF.MainWindow"
        Title="DeveImageOptimizer"
        Height="500" Width="600">
    <Window.Resources>
        <l:KbConverter x:Key="kbConverter"/>
        <l:OptimizedFileResultToSizeConverter x:Key="optimizedFileResultToSizeConverter"/>
        <l:ObservableCollectionOptimizedFileResultToSizeReducedConverter x:Key="observableCollectionOptimizedFileResultToSizeReducedConverter"/>
        <l:ObservableCollectionOptimizedFileResultToTotalSizeBeforeConverter x:Key="observableCollectionOptimizedFileResultToTotalSizeBeforeConverter"/>
        <l:ObservableCollectionOptimizedFileResultToTotalSizeAfterConverter x:Key="observableCollectionOptimizedFileResultToTotalSizeAfterConverter"/>
        <l:OptimizationResultToColorConverter x:Key="optimizationResultToColorConverter"/>
        <l:OptimizedFileResulToErrorStringConverter x:Key="optimizedFileResulToErrorStringConverter"/>
        <l:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <l:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        <l:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="tabControl">
            <TabItem Header="Main" DataContext="{Binding Main, Source={StaticResource Locator}}">
                <Grid Background="AliceBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Path:"/>
                    <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WindowState.ProcessingDirectory}"/>
                        <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}"/>
                    </Grid>
                    <Button Grid.Row="2" Content="{Binding !IsOptimizing, Converter={x:Static l:SwitchBindingConverter.Instance}, ConverterParameter='In Progress...;Go'}" 
                            Command="{Binding GoCommand}" IsEnabled="{Binding !IsOptimizing}"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="3">
                        <Label Content="Filter:" Margin="10,0,0,0"/>
                        <RadioButton Content="All" IsChecked="{Binding FilesProcessingState.Filter, Converter={StaticResource EnumToBooleanConverter}}" Margin="10,0,0,0"/>
                        <RadioButton Content="Success" IsChecked="{Binding FilesProcessingState.Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static loptstate:OptimizationResult.Success}}" Margin="10,0,0,0"/>
                        <RadioButton Content="Skipped" IsChecked="{Binding FilesProcessingState.Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static loptstate:OptimizationResult.Skipped}}" Margin="10,0,0,0"/>
                        <RadioButton Content="Failed" IsChecked="{Binding FilesProcessingState.Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static loptstate:OptimizationResult.Failed}}" Margin="10,0,0,0"/>
                        <RadioButton Content="InProgress" IsChecked="{Binding FilesProcessingState.Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static loptstate:OptimizationResult.InProgress}}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="Processed files"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding FilesProcessingState.ProcessedFilesView}" SelectedItem="{Binding FilesProcessingState.SelectedProcessedFile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{Binding OptimizationResult, Converter={StaticResource optimizationResultToColorConverter}}" />
                                            <TextBlock Margin="10,0,0,0" Grid.Column="1" Text="{Binding RelativePath}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="Details"/>
                            <StackPanel Grid.Row="1">
                                <Label Content="Path:"/>
                                <TextBox Text="{Binding FilesProcessingState.SelectedProcessedFile.Path, Mode=OneWay}" IsReadOnly="True"/>
                                <Label Content="Status:"/>
                                <TextBox Text="{Binding FilesProcessingState.SelectedProcessedFile.OptimizationResult, Mode=OneWay}" IsReadOnly="True"/>
                                <Label Content="Original Size:"/>
                                <TextBox Text="{Binding FilesProcessingState.SelectedProcessedFile.OriginalSize, Mode=OneWay, Converter={StaticResource kbConverter}}" IsReadOnly="True"/>
                                <Label Content="Optimized Size:"/>
                                <TextBox Text="{Binding FilesProcessingState.SelectedProcessedFile.OptimizedSize, Mode=OneWay, Converter={StaticResource kbConverter}}" IsReadOnly="True"/>
                                <Label Content="Size reduced by:"/>
                                <TextBox Text="{Binding FilesProcessingState.SelectedProcessedFile, Mode=OneWay, Converter={StaticResource optimizedFileResultToSizeConverter}}" IsReadOnly="True"/>
                                <Label Content="Error messages:"/>
                                <TextBox Text="{Binding FilesProcessingState.SelectedProcessedFile, Mode=OneWay, Converter={StaticResource optimizedFileResulToErrorStringConverter}}" IsReadOnly="True"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Label Content="Preview Enabled:"/>
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding PreviewEnabled}"/>
                                </StackPanel>

                                <Image Margin="0,10,0,0" IsVisible="{Binding PreviewEnabled}" Source="{Binding FilesProcessingState.SelectedProcessedFile.Path, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="2" Margin="10,0,0,0" Background="CornflowerBlue">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Foreground="White" Grid.Row="0" Content="Total"/>
                            <StackPanel Grid.Row="1">
                                <Label Foreground="White" Content="Original size:"/>
                                <TextBox Text="{Binding FilesProcessingState.ProcessedFiles, Mode=OneWay, Converter={StaticResource observableCollectionOptimizedFileResultToTotalSizeBeforeConverter}}" IsReadOnly="True"/>
                                <Label Foreground="White" Content="Optimized size:"/>
                                <TextBox Text="{Binding FilesProcessingState.ProcessedFiles, Mode=OneWay, Converter={StaticResource observableCollectionOptimizedFileResultToTotalSizeAfterConverter}}" IsReadOnly="True"/>
                                <Label Foreground="White" Content="Size reduced by:"/>
                                <TextBox Text="{Binding FilesProcessingState.ProcessedFiles, Mode=OneWay, Converter={StaticResource observableCollectionOptimizedFileResultToSizeReducedConverter}}" IsReadOnly="True"/>
                                <Label Foreground="White" Content="Total files processed:"/>
                                <TextBox Text="{Binding FilesProcessingState.ProcessedFiles.Count, Mode=OneWay}" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Configuration" DataContext="{Binding Settings, Source={StaticResource Locator}}">
                <Grid Background="AliceBlue" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0">
                        <StackPanel>
                            <Label Content="FileOptimizer Path:"/>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding UserSettingsData.FileOptimizerPath}"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommandFileOptimizer}"/>
                            </Grid>
                            <Label Content="Temp Directory:"/>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding UserSettingsData.TempDirectory}"/>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommandTempDir}"/>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">ImageOptimizationLevel:</Label>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableImageOptimizationLevels}" SelectedItem="{Binding UserSettingsData.ImageOptimizationLevel}"/>
                            </Grid>
                            <CheckBox Content="Directly call optimizers (Skip FileOptimizerFull)" IsChecked="{Binding UserSettingsData.DirectlyCallOptimizers}" Margin="0,10,0,0"/>
                            <CheckBox Content="Hide Optimizer Window (Only set to false for debugging)" IsChecked="{Binding UserSettingsData.HideOptimizerWindow}" Margin="0,10,0,0"/>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">File saving mode:</Label>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableStorageModes}" SelectedItem="{Binding UserSettingsData.RemembererSettings}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <CheckBox Content="Save failed files as {FILENAME}__FAILED" IsChecked="{Binding UserSettingsData.SaveFailedFiles}" Margin="0,10,0,0"/>
                            <CheckBox Content="Keep file attributes (Created/Modified time)" IsChecked="{Binding UserSettingsData.KeepFileAttributes}" Margin="0,10,0,0"/>
                            <CheckBox Content="Use parallel image optimization" IsChecked="{Binding UserSettingsData.ExecuteImageOptimizationParallel}" Margin="0,10,0,0"/>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">MaxDegreeOfParallelism:</Label>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding MaxParallelismChoices}" SelectedItem="{Binding UserSettingsData.MaxDegreeOfParallelism}"/>
                            </Grid>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0">LogLevel:</Label>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLogLevels}" SelectedItem="{Binding UserSettingsData.LogLevel}"/>
                            </Grid>
                            <Label Content="Files to optimize:"/>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="OptimizeJpg" IsChecked="{Binding UserSettingsData.OptimizeJpg}"/>
                                <CheckBox Grid.Column="1" Content="OptimizePng" IsChecked="{Binding UserSettingsData.OptimizePng}"/>
                                <CheckBox Grid.Column="2" Content="OptimizeGif" IsChecked="{Binding UserSettingsData.OptimizeGif}"/>
                                <CheckBox Grid.Column="3" Content="OptimizeBmp" IsChecked="{Binding UserSettingsData.OptimizeBmp}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save" Height="35" VerticalAlignment="Bottom" Command="{Binding SaveCommand}" IsEnabled="{Binding UserSettingsData.IsChanged}"/>
                        <Button Grid.Column="1" Content="Reset to defaults" Height="35" VerticalAlignment="Bottom" Command="{Binding ResetToDefaultsCommand}"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Console Log" DataContext="{Binding Console, Source={StaticResource Locator}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Padding="10,5" Content="Font Size -" Command="{Binding DecreaseFontSizeCommand}"/>
                        <Button Grid.Column="1" Padding="10,5" Content="Font Size +" Command="{Binding IncreaseFontSizeCommand}"/>
                        <TextBlock Grid.Column="2" Padding="10,5" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding ConsoleFontSize, StringFormat=Font size: \{0\}}" Background="White"/>
                        <TextBlock Grid.Column="3" Padding="10,5" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding LoggerExtractinator.LogLines.Count, StringFormat=Line count: \{0\}}" Background="White"/>
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="Logger basic">
                            <ScrollViewer Grid.Row="1" Name="Scroller" Margin="0" Background="Black" HorizontalScrollBarVisibility="Auto" 
                                          h:ScrollViewerExtensions.AlwaysScrollToEnd="{Binding ScrollConfig.AlwaysScrollToEnd}">
                                <ItemsControl ItemsSource="{Binding LoggerExtractinator.LogLines, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="White" FontFamily="Consolas" FontSize="{Binding DataContext.ConsoleFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Logger deluxe">
                            <local:LogViewer Grid.Row="1" LogLines="{Binding LoggerExtractinator.LogLinesEntry}" LogViewerFontSize="{Binding ConsoleFontSize}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>